# ═══════════════════════════════════════════════════
#  JLOODNA GLOBAL TRADING — Variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs
#  JAMAIS committer le fichier .env sur Git !
# ═══════════════════════════════════════════════════

# ── APP ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
SITE_NAME=Jloodna Global Trading

# ── SÉCURITÉ (OBLIGATOIRE — changez en production) ──
JWT_SECRET=generate-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-another-random-secret-at-least-32-characters
COOKIE_SECRET=generate-a-random-cookie-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── BASE DE DONNÉES ──────────────────────────────────
# MongoDB
MONGODB_URI=mongodb://localhost:27017/jloodna
# PostgreSQL (obligatoire pour le déploiement)
DATABASE_URL=postgresql://user:password@host:5432/jloodna?sslmode=require
DB_POOL_MAX=10

# ── PAIEMENTS ────────────────────────────────────────
# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
# NatCash
NATCASH_PHONE=+50955561461
NATCASH_MERCHANT_ID=VOTRE_MERCHANT_ID

# ── EMAIL ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@jloodna.com
SMTP_PASS=VOTRE_MOT_DE_PASSE_APP_GMAIL
EMAIL_FROM=Jloodna Global Trading <contact@jloodna.com>

# ── DEVISES ──────────────────────────────────────────
DEFAULT_CURRENCY=HTG
HTG_TO_DOP_RATE=0.37
HTG_TO_USD_RATE=0.0075

# ── STOCKAGE FICHIERS ────────────────────────────────
# Local (développement)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
# AWS S3 (production)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=jloodna-media
# AWS_REGION=us-east-1
# Cloudinary (alternative)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── RATE LIMITING ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── LIVRAISON ─────────────────────────────────────────
FREE_SHIPPING_THRESHOLD_HTG=5000
DEFAULT_SHIPPING_DAYS=5

# ── ANALYTICS (optionnel) ────────────────────────────
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# FACEBOOK_PIXEL_ID=

# ── LOGS ──────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log
